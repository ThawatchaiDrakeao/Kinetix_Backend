### ============================================================
### พรี่โต API TEST WORKFLOW - RENDER LIVE API
### Target: https://kinetix-qnx5.onrender.com
### Use this file with VS Code REST Client.
### Run `node API_TEST_REPORT/run.render-live-test.mjs` for full logged test.
### ============================================================

@baseUrl = https://kinetix-qnx5.onrender.com
@runId = {{$timestamp}}
@userEmail = preto.render.user.{{runId}}@example.com
@staffEmail = preto.render.admin.{{runId}}@example.com
@password = PretoRenderTest0009!
@brandName = PretoRenderBrand{{runId}}
@categoryName = Road
@existingUserEmail = preto.render.user.20260611091051@example.com

### 01 Health check
GET {{baseUrl}}/

### 02 Staff register - พรี่โต admin first
# @name staffRegister
POST {{baseUrl}}/api/staff/staffRegister
Content-Type: application/json

{
  "name": "พรี่โต",
  "surname": "RenderAdmin",
  "email": "{{staffEmail}}",
  "password": "{{password}}",
  "address": "Kinetix live API test",
  "role": "admin"
}

### 03 Staff login - admin
# @name staffLogin
# REST Client should keep this login cookie for later admin requests.
POST {{baseUrl}}/api/staff/admin/login
Content-Type: application/json

{
  "email": "{{staffRegister.response.body.data.email}}",
  "password": "{{password}}"
}

### 04 User register - customer account, payload includes admin role request
# @name userRegister
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "name": "พรี่โต",
  "surname": "RenderUser",
  "email": "{{userEmail}}",
  "password": "{{password}}",
  "address": "Kinetix live API test",
  "role": "admin"
}

### 05 User register - missing fields
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "missing-fields@example.com",
  "password": "{{password}}"
}

### 06 User login - success
# @name userLogin
# Run request 04 first in this REST Client session. This uses the email returned by userRegister.
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "{{userRegister.response.body.data.email}}",
  "password": "{{password}}"
}

### 07 User login - existing user fallback
# @name existingUserLogin
# Use this if request 06 says User not found because request 04 was not run in this session.
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "{{existingUserEmail}}",
  "password": "{{password}}"
}

### 08 User login - wrong password
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "{{userRegister.response.body.data.email}}",
  "password": "WrongPassword000"
}

### 09 User logout
POST {{baseUrl}}/api/users/logout
